{
  "openapi": "3.0.3",
  "info": {
    "title": "TvDashboard Config Service — Phase 2",
    "version": "2.0.0",
    "description": "API cấu hình TV và trang admin cục bộ. Admin UI dùng session cookie + CSRF, chưa tích hợp SSO công ty. HTTP development; production HTTPS."
  },
  "servers": [
    {
      "url": "http://{pcLanIp}:{port}",
      "description": "Development LAN; thay bằng IP in từ Start-Service.cmd. Production dùng URL HTTPS.",
      "variables": {
        "pcLanIp": {
          "default": "192.168.1.100",
          "description": "Ví dụ; thay bằng IP thật của máy chạy API."
        },
        "port": {
          "default": "8765"
        }
      }
    }
  ],
  "paths": {
    "/api/v1/departments": {
      "get": {
        "operationId": "listDepartments",
        "security": [
          {
            "tvApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "departments"
                  ],
                  "properties": {
                    "departments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Department"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "operationId": "getSettings",
        "security": [
          {
            "tvApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "/api/v1/settings/events": {
            "get": {
              "operationId": "watchSettingsEvents",
              "description": "SSE chỉ gửi tín hiệu invalidation theo phòng ban; TV phải lấy cấu hình có xác thực lại qua /api/v1/settings. Không gửi URL, PIN hoặc verifier.",
              "security": [
                {
                  "tvApiKey": []
                }
              ],
              "parameters": [
                {
                  "name": "department",
                  "in": "query",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]{1,32}$"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "text/event-stream; ready và settings-changed chỉ chứa department."
                },
                "403": {
                  "description": "Key không có quyền với phòng ban."
                }
              }
            }
          },
          "400": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "department",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,32}$"
            }
          },
          {
            "name": "deviceId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "UUID v4"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          {
            "name": "appVersion",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 32
            }
          }
        ]
      }
    },
    "/api/v1/devices/{deviceId}/diagnostics": {
      "get": {
        "operationId": "getDeviceDiagnostics",
        "security": [
          {
            "adminBearer": []
          },
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/deviceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Chính sách server, xác nhận TV và log; chỉ admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiagnosticsState"
                }
              }
            }
          },
          "401": {
            "description": "Cần đăng nhập admin"
          },
          "403": {
            "description": "Không có quyền"
          }
        }
      },
      "put": {
        "operationId": "setDeviceDiagnostics",
        "security": [
          {
            "adminBearer": []
          },
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/deviceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đã cập nhật chính sách server; TV cần xác nhận qua API."
          },
          "401": {
            "description": "Cần đăng nhập admin"
          }
        }
      },
      "delete": {
        "operationId": "deleteDeviceDiagnostics",
        "security": [
          {
            "adminBearer": []
          },
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/deviceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Đã xóa log của thiết bị."
          },
          "401": {
            "description": "Cần đăng nhập admin"
          }
        }
      },
      "post": {
        "operationId": "uploadDeviceDiagnostics",
        "security": [
          {
            "tvApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/deviceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "events"
                ],
                "properties": {
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "$ref": "#/components/schemas/DiagnosticEvent"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đã nhận sự kiện; event ID được khử trùng lặp."
          },
          "403": {
            "description": "Key sai thiết bị/phòng ban hoặc chính sách tắt."
          }
        }
      }
    },
    "/api/v1/devices/{deviceId}/diagnostics/ack": {
      "post": {
        "operationId": "ackDeviceDiagnosticsPolicy",
        "security": [
          {
            "tvApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/deviceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "enabled",
                  "version"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "TV xác nhận đã nhận đúng phiên bản chính sách."
          },
          "409": {
            "description": "Chính sách đã đổi."
          }
        }
      }
    },
    "/api/v1/devices/{deviceId}/phone-pin/ack": {
      "post": {
        "operationId": "ackDevicePhonePinPolicy",
        "security": [
          {
            "tvApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/deviceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "version"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "TV xác nhận đã nhận phiên bản PIN."
          },
          "409": {
            "description": "Chính sách PIN đã đổi."
          }
        }
      }
    },
    "/admin/api/devices/{deviceId}/phone-pin": {
      "get": {
        "operationId": "getDevicePhonePinMode",
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/deviceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Chế độ và trạng thái xác nhận; không trả PIN hoặc verifier.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "mode",
                    "version",
                    "tvApplied"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "random",
                        "custom"
                      ]
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "tvApplied": {
                      "type": "boolean"
                    },
                    "appliedAt": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "setDevicePhonePinMode",
        "security": [
          {
            "adminSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/deviceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "mode"
                    ],
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "random"
                        ]
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "mode",
                      "pin"
                    ],
                    "properties": {
                      "mode": {
                        "type": "string",
                        "enum": [
                          "custom"
                        ]
                      },
                      "pin": {
                        "type": "string",
                        "pattern": "^[0-9]{6,8}$"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lưu chính sách server; TV cần nhận và xác nhận phiên bản mới."
          },
          "400": {
            "description": "PIN hoặc mode không hợp lệ."
          }
        }
      }
    },
    "/api/v1/departments/{id}/settings": {
      "put": {
        "operationId": "updateSettings",
        "security": [
          {
            "adminBearer": []
          },
          {
            "adminSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "department",
                    "dashboardUrl",
                    "version",
                    "updatedAt"
                  ],
                  "properties": {
                    "department": {
                      "$ref": "#/components/schemas/Department"
                    },
                    "dashboardUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Xem mã lỗi trong hợp đồng API",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,32}$"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Bắt buộc khi dùng session cookie; không cần khi dùng Bearer token."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "dashboardUrl",
                  "expectedVersion"
                ],
                "properties": {
                  "dashboardUrl": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048
                  },
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "description": "Cập nhật với expectedVersion. Bearer admin token hoặc session + Origin/CSRF. Cookie sửa ghi username vào audit."
      }
    },
    "/api/v1/devices": {
      "get": {
        "operationId": "listDevices",
        "security": [
          {
            "adminBearer": []
          },
          {
            "adminSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Thành công",
