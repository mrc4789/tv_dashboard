  "components": {
    "parameters": {
      "deviceId": {
        "name": "deviceId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid",
          "description": "UUID v4 của thiết bị đã đăng ký"
        }
      }
    },
    "securitySchemes": {
      "tvApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      },
      "adminBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tv_admin_session",
        "description": "Session 8 giờ từ /admin/api/login. Mutation cần Origin cùng site và header X-CSRF-Token."
      }
    },
    "schemas": {
      "Department": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}$"
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "block",
              "team"
            ]
          }
        }
      },
      "Settings": {
        "type": "object",
        "required": [
          "department",
          "dashboardUrl",
          "version",
          "pollSeconds",
          "serverTime",
          "diagnosticsEnabled",
          "diagnosticsPolicyVersion",
          "phonePinPolicy",
          "phonePinPolicyVersion"
        ],
        "properties": {
          "department": {
            "$ref": "#/components/schemas/Department"
          },
          "dashboardUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "pollSeconds": {
            "type": "integer",
            "enum": [
              300
            ]
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          },
          "diagnosticsEnabled": {
            "type": "boolean",
            "description": "Chính sách server; TV xác nhận riêng qua diagnostics/ack."
          },
          "diagnosticsPolicyVersion": {
            "type": "integer",
            "minimum": 0
          },
          "phonePinPolicy": {
            "$ref": "#/components/schemas/PhonePinPolicy"
          },
          "phonePinPolicyVersion": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PhonePinPolicy": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "random"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "mode",
              "salt",
              "hash",
              "iterations"
            ],
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "custom"
                ]
              },
              "salt": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$"
              },
              "hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "iterations": {
                "type": "integer",
                "enum": [
                  100000
                ]
              }
            }
          }
        ],
        "description": "Verifier salted; không chứa PIN rõ."
      },
      "DiagnosticEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "code",
          "occurredAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "NETWORK",
              "HTTP_SERVER",
              "SSL",
              "TIMEOUT",
              "RENDERER",
              "LOADED"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{0,3}$"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DiagnosticsState": {
        "type": "object",
        "required": [
          "enabled",
          "policyVersion",
          "tvAcknowledged",
          "items"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "policyVersion": {
            "type": "integer",
            "minimum": 0
          },
          "tvAcknowledged": {
            "type": "boolean"
          },
          "acknowledgedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "occurred_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "received_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "Device": {
        "type": "object",
        "required": [
          "deviceId",
          "name",
          "department",
          "lastSeenAt",
          "status"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 64
          },
          "department": {
            "$ref": "#/components/schemas/Department"
          },
          "appVersion": {
            "type": "string",
            "nullable": true
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "online",
              "offline"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  }
}
