<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- WebView được tạo bằng code và thêm vào đây (để dựng lại được khi WebView crash) -->
    <FrameLayout
        android:id="@+id/webContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Lớp phủ trạng thái: đang tải, chờ mạng, lỗi, chưa cấu hình.
         Lề 96dp ngang / 54dp dọc để không bị cắt do overscan trên TV. -->
    <LinearLayout
        android:id="@+id/statusOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="54dp"
        android:paddingEnd="96dp"
        android:paddingBottom="54dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/statusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="@color/on_background"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/muted"
            android:textSize="24sp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>