<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="96dp"
        android:paddingTop="54dp"
        android:paddingEnd="96dp"
        android:paddingBottom="54dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/on_background"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/config_mode" android:textColor="@color/muted" android:textSize="18sp" />
        <Spinner android:id="@+id/modeSpinner" android:layout_width="match_parent" android:layout_height="56dp" android:entries="@array/config_modes" />
        <LinearLayout android:id="@+id/serverPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/server_url_label" android:textColor="@color/muted" android:textSize="18sp" android:labelFor="@id/serverInput" />
            <EditText android:id="@+id/serverInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_input" android:inputType="textUri" android:singleLine="true" android:padding="16dp" android:textColor="@color/on_background" android:textColorHint="@color/muted" android:hint="@string/server_url_hint" android:importantForAutofill="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/api_key_label" android:textColor="@color/muted" android:labelFor="@id/apiKeyInput" />
            <EditText android:id="@+id/apiKeyInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_input" android:inputType="textPassword" android:singleLine="true" android:padding="16dp" android:textColor="@color/on_background" android:importantForAutofill="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/department_label" android:textColor="@color/muted" />
            <Spinner android:id="@+id/departmentSpinner" android:layout_width="match_parent" android:layout_height="56dp" />
            <Button android:id="@+id/loadDepartmentsButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/load_departments" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/tv_name_label" android:textColor="@color/muted" android:labelFor="@id/tvNameInput" />
            <EditText android:id="@+id/tvNameInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_input" android:inputType="text" android:singleLine="true" android:maxLength="64" android:padding="16dp" android:textColor="@color/on_background" android:importantForAutofill="no" />
            <TextView android:id="@+id/deviceIdText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/muted" android:textSize="14sp" />
            <Button android:id="@+id/syncNowButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/sync_now" />
            <TextView android:id="@+id/remoteSyncStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/on_background" android:textSize="18sp" />
            <TextView android:id="@+id/remoteRealtimeStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/poll_reload_hint" android:textColor="@color/muted" android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:labelFor="@+id/urlInput"
            android:text="@string/settings_url_label"
            android:textColor="@color/muted"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/settings_url_hint"
            android:imeOptions="actionNext|flagNoExtractUi|flagNoFullscreen"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:nextFocusDown="@id/intervalInput"
            android:padding="16dp"
            android:singleLine="true"
            android:textColor="@color/on_background"
            android:textColorHint="@color/muted"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/urlError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/error"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@+id/intervalInput"
            android:text="@string/settings_interval_label"
            android:textColor="@color/muted"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/intervalInput"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
            android:importantForAutofill="no"
            android:inputType="number"
            android:nextFocusUp="@id/urlInput"
            android:nextFocusDown="@id/saveButton"
            android:padding="16dp"
            android:singleLine="true"
            android:textColor="@color/on_background"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/intervalError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/interval_error"
            android:textColor="@color/error"
            android:textSize="18sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/saveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button"
                android:minWidth="160dp"
                android:minHeight="56dp"
                android:nextFocusUp="@id/intervalInput"
                android:nextFocusRight="@id/testButton"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/settings_save"
                android:textColor="@color/button_text"
                android:textSize="20sp" />

            <Button
                android:id="@+id/testButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_button"
                android:minWidth="160dp"
                android:minHeight="56dp"
                android:nextFocusUp="@id/intervalInput"
                android:nextFocusLeft="@id/saveButton"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/settings_test"
                android:textColor="@color/button_text"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/resultText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/on_background"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/remote_title"
            android:textColor="@color/on_background"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/qrImage"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:contentDescription="@string/remote_qr_description"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="24dp">

                <TextView
                    android:id="@+id/remoteAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_background"
                    android:textSize="24sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/remotePin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/accent"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/remoteStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/muted"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/homeStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textColor="@color/muted" android:textSize="18sp" />
        <Button android:id="@+id/selectHomeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chọn TV Dashboard làm màn hình Home" />
        <Button android:id="@+id/openHomeSettingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mở cài đặt Home hệ thống / đổi launcher" />

        <Button android:id="@+id/refreshPhoneSetupButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tạo lại QR / PIN cấu hình" />

        <TextView
            android:id="@+id/autostartHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/autostart_hint"
            android:textColor="@color/muted"
            android:textSize="18sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>